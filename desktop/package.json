{
  "name": "evalora-secure-browser",
  "version": "1.0.0",
  "description": "Official Secure Lockdown Examination Application for EVALORA Assessment Suite",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "EVALORA Assessment Systems",
  "license": "Proprietary",
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.evalora.lockdown",
    "productName": "EVALORA Secure Exam Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "protocols": {
      "name": "EVALORA Lockdown Protocol",
      "schemes": [
        "evalora-lockdown"
      ]
    }
  }
}
